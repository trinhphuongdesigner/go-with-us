{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careermate.local/schemas/v2-feature-report.json",
  "title": "CareerMate v2 Feature Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_language",
    "feature_id",
    "feature_name",
    "branch",
    "implementation_sha",
    "generated_at",
    "scope",
    "user_value",
    "functional_breakdown",
    "acceptance_criteria",
    "checks",
    "persona_reviews",
    "known_gaps",
    "overall_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_language": { "const": "vi" },
    "feature_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "feature_name": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "implementation_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Commit code đã được kiểm thử; không phải SHA tự tham chiếu của commit chứa report."
    },
    "verified_tree_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git tree của implementation_sha. Bắt buộc và phải khớp với commit khi overall_status là PASS."
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "python": { "type": "string" },
        "node": { "type": "string" },
        "browser": { "type": "string" },
        "database": {
          "type": "string",
          "description": "Chỉ tên loại/test DB đã redact, không chứa connection string."
        },
        "ai_provider": {
          "type": ["string", "null"],
          "description": "Tên provider/model, không chứa key."
        }
      }
    },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "user_value": { "type": "string", "minLength": 1 },
    "functional_breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "actor", "behavior"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "behavior": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "change"],
        "properties": {
          "kind": { "enum": ["API", "DATABASE", "EVENT", "AI_SCHEMA", "UI_ROUTE"] },
          "name": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status", "evidence_check_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
          "evidence_check_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "category", "required", "status", "command", "cwd",
          "started_at", "finished_at", "exact_sha", "summary", "artifact_paths"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CHK-[A-Z0-9-]+$" },
          "category": {
            "enum": [
              "FORMAT", "LINT", "TYPECHECK", "UNIT", "INTEGRATION", "CONTRACT",
              "MIGRATION", "E2E", "ACCESSIBILITY", "SECURITY", "PERFORMANCE",
              "AI_GROUNDING", "MANUAL_UI", "BUILD", "PUSH"
            ]
          },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
          "command": { "type": "string", "minLength": 1 },
          "cwd": { "type": "string", "minLength": 1 },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "exit_code": { "type": ["integer", "null"] },
          "exact_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "summary": { "type": "string", "minLength": 1 },
          "artifact_paths": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": ["number", "integer", "string", "boolean", "null"] }
          },
          "blocker": { "type": ["string", "null"] },
          "retry_instruction": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "BLOCKED" } } },
            "then": {
              "required": ["blocker", "retry_instruction"],
              "properties": {
                "blocker": { "type": "string", "minLength": 1 },
                "retry_instruction": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "if": { "properties": { "status": { "enum": ["PASS", "FAIL"] } } },
            "then": {
              "required": ["exit_code"],
              "properties": {
                "started_at": { "type": "string", "format": "date-time" },
                "finished_at": { "type": "string", "format": "date-time" },
                "exit_code": { "type": "integer" }
              }
            }
          }
        ]
      }
    },
    "persona_reviews": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["persona", "viewport", "status", "findings"],
        "properties": {
          "persona": { "enum": ["EMPLOYEE_22_30", "HR_35_45", "MANAGER_45_55", "LOW_TECH_USER"] },
          "viewport": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["severity", "description", "resolution"],
              "properties": {
                "severity": { "enum": ["P0", "P1", "P2"] },
                "description": { "type": "string", "minLength": 1 },
                "resolution": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "security_privacy_notes": { "type": "array", "items": { "type": "string" } },
    "ai_grounding_notes": { "type": "array", "items": { "type": "string" } },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "route", "viewport", "sha"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "viewport": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "impact", "next_action"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "impact": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "next_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "overall_status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] }
  },
  "allOf": [
    {
      "if": { "properties": { "overall_status": { "const": "PASS" } } },
      "then": {
        "required": ["verified_tree_sha"],
        "properties": {
          "verified_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  ]
}
