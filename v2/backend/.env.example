# Example env for local dev only. Never commit real secrets.
CAREERMATE_ENVIRONMENT=local
CAREERMATE_DATABASE_URL=postgresql+asyncpg://careermate:careermate@localhost:55432/careermate_v2
CAREERMATE_TEST_DATABASE_URL=postgresql+asyncpg://careermate:careermate@localhost:55432/careermate_v2_test

CAREERMATE_JWT_SECRET=replace-with-at-least-32-random-characters
CAREERMATE_JWT_ALGORITHM=HS256
CAREERMATE_JWT_ISSUER=careermate-v2
CAREERMATE_JWT_AUDIENCE=careermate-v2-web
CAREERMATE_ACCESS_TOKEN_EXPIRE_MINUTES=60
CAREERMATE_LOGIN_RATE_LIMIT_ATTEMPTS=5
CAREERMATE_LOGIN_RATE_LIMIT_IP_ATTEMPTS=25
CAREERMATE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CAREERMATE_LOGIN_RATE_LIMIT_MAX_KEYS=10000

# Profile import AI is disabled unless all three values are configured. The endpoint must be the
# full OpenAI-compatible chat-completions URL. Never commit a real API key.
# CAREERMATE_PROFILE_IMPORT_AI_ENDPOINT=https://provider.example/v1/chat/completions
# CAREERMATE_PROFILE_IMPORT_AI_MODEL=provider-model-id
# CAREERMATE_PROFILE_IMPORT_AI_API_KEY=replace-with-a-local-secret
CAREERMATE_PROFILE_IMPORT_AI_TIMEOUT_SECONDS=15
CAREERMATE_PROFILE_IMPORT_AI_MAX_ATTEMPTS=2

# Demo seeding is local/test only. Set three different values of at least 12 characters.
CAREERMATE_DEMO_SUPER_ADMIN_PASSWORD=set-a-unique-local-super-admin-password
CAREERMATE_DEMO_COMPANY_ADMIN_PASSWORD=set-a-unique-local-company-admin-password
CAREERMATE_DEMO_EMPLOYEE_PASSWORD=set-a-unique-local-employee-password
