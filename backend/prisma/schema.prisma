// Prisma schema for CareerMate — competency/HR profile management platform.
// See D:\Coding\AI_Tool\docs\new-project-prompt-template.md (section A/B) for
// the architecture this was scaffolded from.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  BOD
  HR
  EMPLOYEE
}

enum AdminPermission {
  VIEW
  COLLECT
  CROSS_ASSESS
  APPROVE
  EDIT
  FULL
}

/// Explicit mapping to profile scores; never infer a dimension from a name.
enum AssessmentScoreDimension {
  CONTRIBUTION
  ATTITUDE
}

enum ThemeConcept {
  DEFAULT
  ANIME
  FILM
  GATHER_TOWN
}

enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
}

/// A person's account outlives any single company, so an employment period
/// is its own record — see docs/careermate-scope.md section 2.3.
enum EmploymentStatus {
  ACTIVE
  ENDED
}

enum CertificationType {
  DEGREE
  LANGUAGE
  PROFESSIONAL
  OTHER
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CycleStatus {
  OPEN
  CLOSED
}

/// Who is filling an assessment in. SELF is the monthly mood/highlight
/// check-in; PEER/MANAGER are the cross-assessment side of it.
enum AssessmentType {
  SELF
  PEER
  MANAGER
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ImportSourceType {
  CV_TEXT
  CV_FILE
  LINKEDIN_URL
}

enum ImportStatus {
  PENDING
  PARSED
  APPLIED
  FAILED
}

/// Who asked for a CareerSummary to be written.
enum CareerSummarySource {
  /// The owner generates and saves their own recap, any time.
  SELF_REQUESTED
  /// The owner requests it, but the ORG (admin) triggers generation and
  /// approves it — this is what makes it a credible, portable record.
  ORGANIZATION_OFFBOARDING
}

enum CareerSummaryStatus {
  /// SELF_REQUESTED rows default straight to APPROVED (self-authored, no
  /// review step needed). ORGANIZATION_OFFBOARDING rows start here and stay
  /// DRAFT through request -> trigger -> admin review.
  DRAFT
  APPROVED
}

/// Focus/topic of an assistant conversation — each screen gets a context
/// builder tailored to it instead of one generic chat.
enum AssistantFocus {
  GENERAL
  ROADMAP
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  jobRequirements JobRequirement[]

  employments         Employment[]
  assessmentTemplates AssessmentTemplate[]
  assessmentCycles    AssessmentCycle[]
  projectExperiences  ProjectExperience[]
  passportShares      CareerPassportShare[]
  roleDefinitions     RoleDefinition[]
  competencyRequests  CompetencyRequest[]
}

/// Dynamic role definitions per company (or global for SUPER_ADMIN).
/// SUPER_ADMIN and COMPANY_ADMIN are hidden system roles with fixed permissions.
/// HR and BOD are editable via the role management UI.
model RoleDefinition {
  id          String            @id @default(cuid())
  companyId   String?
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        Role
  permissions AdminPermission[]
  isHidden    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([companyId, role])
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role
  adminPermissions AdminPermission[] @default([])
  // Pointer to the CURRENT employer only — history lives in Employment[].
  // Goes null when the person leaves; their assessment record survives via
  // Employment (docs/careermate-scope.md section 2.3). SetNull rather than
  // Cascade so deleting a company never destroys a person's career record.
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)

  avatarUrl String?
  // Self-described professional title/specialty (e.g. "Frontend Developer").
  // Distinct from Employment.jobTitle, which is the role a person holds AT
  // A SPECIFIC COMPANY and can differ per employment (e.g. FE here, Full
  // Stack there) — this field is the person's own portable identity.
  jobTitle  String?

  // Personal info fields — self-editable by the employee except
  // onboardDate, which UsersService blocks employees from setting on
  // themselves since it's an HR-controlled milestone, not something to
  // self-report.
  phone                 String?
  dateOfBirth           DateTime?
  idNumber              String? // CCCD / CMND
  gender                String?
  onboardDate           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Only meaningful for EMPLOYEE role — Admin side always stays DEFAULT.
  themeConcept ThemeConcept @default(DEFAULT)

  // Admin-collected metrics about an employee.
  contributionScore Float?
  attitudeScore     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills                 EmployeeSkill[]
  activityLogs           ActivityLog[]
  goals                  DevelopmentGoal[]
  developmentPlans       DevelopmentPlan[]
  jobRequirementsCreated JobRequirement[]

  // CareerMate additions — see docs/careermate-scope.md.
  employments                Employment[]
  certifications             Certification[]
  projectExperiences         ProjectExperience[]
  awards                     Award[]
  profileImports             ProfileImport[]
  careerSummaries            CareerSummary[]
  careerSummaryRequests      CareerSummary[]         @relation("careerSummaryRequestedBy")
  careerSummaryApprovals     CareerSummary[]         @relation("careerSummaryApprovedBy")
  passportShares             CareerPassportShare[]
  assistantConversations     AssistantConversation[]
  assessmentsReceived        Assessment[]            @relation("assessmentReviewee")
  assessmentsGiven           Assessment[]            @relation("assessmentReviewer")
  assessmentsApproved        Assessment[]            @relation("assessmentApprover")
  assessmentTemplatesCreated AssessmentTemplate[]

  competencyRequestsSent     CompetencyRequest[] @relation("CompetencyRequestSender")
  competencyRequestsReceived CompetencyRequest[] @relation("CompetencyRequestRecipient")
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  employeeSkills EmployeeSkill[]
}

model EmployeeSkill {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id])
  level        Int
  selfAssessed Boolean  @default(true)
  note         String?
  updatedAt    DateTime @updatedAt

  @@unique([userId, skillId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  /// URL to a photo/certificate (outside Spaces) OR Spaces upload (prefix careermate/activity-evidence/).
  evidenceUrl String?
  date        DateTime
  createdAt   DateTime @default(now())
}

model DevelopmentGoal {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  metric       String?
  targetValue  Float?
  currentValue Float?
  progress     Int          @default(0) // 0-100, user-maintained
  dueDate      DateTime?
  status       GoalStatus   @default(NOT_STARTED)
  aiScore      Float?
  aiSuggested  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model DevelopmentPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String // markdown
  aiGenerated Boolean  @default(false)
  status      String   @default("draft")
  // Roadmap UI prefs (character, view mode, costume color, reduce motion,
  // font size) — a display concern, not queryable business data.
  displaySettings Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions DevelopmentPlanVersion[]
  roadmaps DevelopmentRoadmap[]
}

model DevelopmentPlanVersion {
  id            String          @id @default(cuid())
  planId        String
  plan          DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  content       String
  changeSummary String?
  createdAt     DateTime        @default(now())
}

model JobRequirement {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  title          String
  description    String
  requiredSkills String[]
  status         String   @default("open")
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CareerMate — portable career record (docs/careermate-scope.md section 2.3)
// ---------------------------------------------------------------------------

/// One stint at one company. This is what every assessment, project and
/// career summary hangs off, so the record keeps its "which company, which
/// period, which position" context even after the person leaves and
/// User.companyId goes null.
model Employment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle   String
  level      String? // Junior / Middle / Senior — free text, company-defined
  department String?
  startDate  DateTime
  endDate    DateTime?
  status     EmploymentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  assessments        Assessment[]
  projectExperiences ProjectExperience[]
  careerSummaries    CareerSummary[]

  @@index([userId])
  @@index([companyId])
}

/// AI-written recap of one employment period (attitude, competency at that
/// position, growth over time). Generated as a proposal, saved explicitly —
/// same convention as DevelopmentPlan.
///
/// Two very different lifecycles share this table:
///  - SELF_REQUESTED: owner generates + saves in one sitting, `content` is
///    the whole thing, status is APPROVED immediately.
///  - ORGANIZATION_OFFBOARDING: owner requests (empty DRAFT row) -> admin
///    triggers AI (`generatedAt` set, `content` = redacted narrative,
///    `evaluation`/`dimensionScores` = locked org judgement) -> admin may
///    edit ONLY `content` -> admin approves (`status` -> APPROVED). The API
///    layer is what enforces "narrative editable, evaluation locked" — see
///    CareerPassportService.
model CareerSummary {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentId    String?
  employment      Employment?         @relation(fields: [employmentId], references: [id], onDelete: SetNull)
  content         String // markdown narrative — the only field an admin may edit post-generation
  /// Org-sourced judgement (attitude/competency prose), from approved
  /// Assessments only. Never exposed on an update DTO — locked once written.
  evaluation      String?
  /// Fixed 5-axis scores (0-10) so passports compare across companies with
  /// different AssessmentTemplates: { attendance, proactiveness, knowledge,
  /// skill, activityParticipation }. Locked, same as `evaluation`.
  dimensionScores Json?
  strengths       String[]
  growthAreas     String[]
  aiGenerated     Boolean             @default(true)
  source          CareerSummarySource @default(SELF_REQUESTED)
  status          CareerSummaryStatus @default(APPROVED)
  requestedById   String?
  requestedBy     User?               @relation("careerSummaryRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt     DateTime?
  /// Null = requested but AI hasn't run yet ("waiting for admin to trigger").
  generatedAt     DateTime?
  approvedById    String?
  approvedBy      User?               @relation("careerSummaryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime            @default(now())

  @@index([userId])
  @@index([employmentId])
}

/// Owner-created read-only link so a prospective employer can review the
/// career record. Revocable and expirable — the owner stays in control.
model CareerPassportShare {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  label     String? // e.g. "Applying to FPT Software"
  /// Optional: the company this was issued for, when it exists on-platform.
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  expiresAt DateTime?
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// CareerMate — competency profile (M1) + CV/LinkedIn import (M2)
// ---------------------------------------------------------------------------

model Certification {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  type          CertificationType @default(PROFESSIONAL)
  /// Free text so "IELTS 7.0" and "TOEIC 600" both fit.
  score         String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
}

/// The "lịch sử dự án tham gia" section of the profile — real experience,
/// not just a list of project names.
model ProjectExperience {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for projects done before joining any company on the platform.
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employmentId String?
  employment   Employment? @relation(fields: [employmentId], references: [id], onDelete: SetNull)
  name         String
  role         String
  domain       String?
  techStack    String[]
  contribution String? // đóng góp / kết quả nổi bật
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
}

/// Awards and competitions — best staff, internal hackathon, competitions,
/// etc. — self-reportable with evidence.
model Award {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  issuer       String?
  description  String?
  /// External URL or Spaces upload under careermate/award-evidence/.
  evidenceUrl  String?
  awardedAt    DateTime?
  selfReported Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([userId])
}

enum CompetencyRequestSourceType {
  CERTIFICATION
  AWARD
}

enum CompetencyRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An employee asking a specific HR at one of their current companies to
/// review a certification/award and (optionally) award points. Not an
/// auto-scoring mechanism — HR decides the amount, if any, on approval.
model CompetencyRequest {
  id          String @id @default(cuid())
  senderId    String
  sender      User   @relation("CompetencyRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User   @relation("CompetencyRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sourceType CompetencyRequestSourceType
  sourceId   String
  /// Frozen copy of the source record's display fields at request time
  /// (title/name, issuer, score/description, evidenceUrl) — survives the
  /// source being edited or deleted later, same idea as
  /// Assessment.templateSnapshot.
  sourceSnapshot Json

  message String?

  status        CompetencyRequestStatus @default(PENDING)
  pointsAwarded Int?
  reviewNote    String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, status])
  @@index([senderId])
}

/// A CV paste / uploaded CV text / LinkedIn URL that the AI turns into
/// structured profile data. Proposal-only: parsedData is shown to the user,
/// and nothing lands in the profile until they apply it.
model ProfileImport {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType ImportSourceType
  sourceName String? // original file name or LinkedIn URL
  /// Extracted plain text — no object storage, per CLAUDE.md.
  rawText    String
  /// AI proposal: { profile, skills[], certifications[], projects[], awards[] }
  parsedData Json?
  status     ImportStatus     @default(PENDING)
  error      String?
  appliedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// CareerMate — Cross Assessment, company-configurable (M3)
// ---------------------------------------------------------------------------

/// A company's own competency scale: groups → questions, each weighted.
model AssessmentTemplate {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  name        String
  description String?
  status      TemplateStatus @default(DRAFT)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  groups      AssessmentGroup[]
  cycles      AssessmentCycle[]
  assessments Assessment[]

  @@index([companyId])
}

model AssessmentGroup {
  id             String                   @id @default(cuid())
  templateId     String
  template       AssessmentTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// Relative weight of this group within the template.
  weight         Float                    @default(1)
  scoreDimension AssessmentScoreDimension @default(CONTRIBUTION)
  order          Int                      @default(0)

  questions AssessmentQuestion[]

  @@index([templateId])
}

model AssessmentQuestion {
  id       String          @id @default(cuid())
  groupId  String
  group    AssessmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text     String
  /// "mô tả expand" — what this criterion means / how to score it.
  guidance String?
  weight   Float           @default(1)
  maxScore Int             @default(10)
  order    Int             @default(0)

  answers AssessmentAnswer[]

  @@index([groupId])
}

/// A round of assessment, normally one per month per company.
model AssessmentCycle {
  id         String             @id @default(cuid())
  companyId  String
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId String
  template   AssessmentTemplate @relation(fields: [templateId], references: [id])
  name       String
  /// "YYYY-MM" — the month this cycle covers.
  period     String
  status     CycleStatus        @default(OPEN)
  dueDate    DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  assessments Assessment[]

  @@unique([companyId, period])
  @@index([companyId])
}

/// One filled-in assessment. Survives the reviewee leaving the company
/// because it points at Employment, and keeps templateSnapshot so later
/// edits to the company's template never rewrite approved history.
model Assessment {
  id                String             @id @default(cuid())
  cycleId           String?
  cycle             AssessmentCycle?   @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  templateId        String
  template          AssessmentTemplate @relation(fields: [templateId], references: [id])
  revieweeId        String
  reviewee          User               @relation("assessmentReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId        String
  reviewer          User               @relation("assessmentReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  employmentId      String?
  employment        Employment?        @relation(fields: [employmentId], references: [id], onDelete: SetNull)
  type              AssessmentType
  /// Monthly self check-in fields (SELF only).
  mood              String?
  highlights        String?
  comment           String?
  /// Weighted total, computed on submit from the answers.
  totalScore        Float?
  /// Weighted 0-10 scores, frozen on approval and averaged onto User.
  contributionScore Float?
  attitudeScore     Float?
  status            AssessmentStatus   @default(DRAFT)
  submittedAt       DateTime?
  approvedById      String?
  approvedBy        User?              @relation("assessmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  /// Frozen copy of the template (groups/weights/questions) taken at
  /// approval — this is what makes an approved assessment immutable history.
  templateSnapshot  Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  answers AssessmentAnswer[]

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([cycleId])
}

model AssessmentAnswer {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  score        Int // 1-10 against the question's maxScore
  comment      String?

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// ---------------------------------------------------------------------------
// CareerMate — development roadmap milestones (M6)
// ---------------------------------------------------------------------------

/// One saved roadmap "attempt" for a category. Every explicit save (AI
/// proposal or the customize panel) creates a new row instead of
/// overwriting — see development-plans.service.ts#saveRoadmap — so a person
/// can keep several roadmaps side by side instead of losing history.
model DevelopmentRoadmap {
  id            String          @id @default(cuid())
  planId        String
  plan          DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  durationWeeks Int?
  hoursPerWeek  Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  milestones DevelopmentMilestone[]

  @@index([planId])
}

/// Measurable checkpoints under a DevelopmentRoadmap — the markdown plan
/// stays the narrative, these are the trackable parts of one roadmap attempt.
model DevelopmentMilestone {
  id          String             @id @default(cuid())
  roadmapId   String
  roadmap     DevelopmentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus    @default(NOT_STARTED)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tasks DevelopmentTask[]

  @@index([roadmapId])
}

model DevelopmentTask {
  id          String               @id @default(cuid())
  milestoneId String
  milestone   DevelopmentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  /// How completion is measured, e.g. "ship 2 features as tech lead".
  metric      String?
  done        Boolean              @default(false)
  order       Int                  @default(0)

  @@index([milestoneId])
}

// ---------------------------------------------------------------------------
// CareerMate — cross-cutting AI assistant (M5)
// ---------------------------------------------------------------------------

model AssistantConversation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// Set once at creation from the first message's focus — a conversation
  /// doesn't change topic mid-thread. GENERAL keeps today's behaviour
  /// (roster search for admins / personal companion for employees).
  focus     AssistantFocus @default(GENERAL)
  /// Pinned threads sort first in the history list (full page + floating panel).
  pinned    Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages AssistantMessage[]

  @@index([userId])
}

model AssistantMessage {
  id                String                @id @default(cuid())
  conversationId    String
  conversation      AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role              String
  content           String
  /// Employee ids the assistant surfaced, so the UI can link to profiles.
  referencedUserIds String[]
  /// Structured roadmap proposal (ROADMAP focus only) — set when the model
  /// decided it has enough context to propose milestones/tasks instead of
  /// asking a clarifying question. Shape: { milestones: [{ title,
  /// description?, dueDate?, tasks: [{ title, metric? }] }] }.
  proposalData      Json?
  createdAt         DateTime              @default(now())

  @@index([conversationId])
}

model AiProviderConfig {
  id        String     @id @default(cuid())
  provider  AiProvider @unique
  apiKey    String
  baseUrl   String?
  model     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
